<!DOCTYPE html>
<html lang="pt-BR" class="dark scroll-smooth">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>AXIOM Strategic Intelligence | Apresentação Executiva</title>

  <!-- Fonts CDN -->
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=Ethnocentric+Bold&family=Eurostile+Extended&family=Share+Tech+Mono:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet" />


  <style>
    /* ═══════════════════════════════════════════════════════════
       AXIOM STRATEGIC INTELLIGENCE — APRESENTAÇÃO EXECUTIVA
       
    ═══════════════════════════════════════════════════════════ */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --clr-bg: #050508;
      --clr-surface: #0a0a10;
      --clr-surface-light: #12131b;
      --clr-accent-primary: #fb7507;
      --clr-accent-dark: #a68338;
      --clr-accent-light: #e8d08a;
      --clr-secondary: #2563a8;
      --clr-secondary-dark: #1a3a6e;
      --clr-secondary-light: #3b7dd8;
      --clr-success: #22c55e;
      --clr-warning: #f59e0b;
      --clr-error: #ef4444;
      --clr-info: #06b6d4;
      --clr-white: #f0f4ff;
      --clr-muted: rgba(220, 210, 240, 0.72);
      --clr-dim: rgba(210, 210, 240, 0.564);
      --clr-border: rgba(255, 255, 255, 0.07);
      /* Background cinza chumbo — 2ª dobra (empresa) e 4ª dobra (diagnóstico) */
      --clr-chumbo: #1f2025;
      /* Tags prateadas — 1ª dobra (badges) e 3ª dobra (Tecnologias & Skills) */
      --clr-hero-badge: #c0c0c0;
      --clr-hero-badge-bg: rgba(192, 192, 192, 0.08);
      --clr-hero-badge-border: rgba(192, 192, 192, 0.35);
      --clr-hero-badge-bg-hover: rgba(192, 192, 192, 0.15);
      /* Chatbot — 5ª dobra (Assistente Comercial Virtual) */
      --clr-chatbot-bg: rgba(10, 10, 16, 0.94);
      --clr-chatbot-header-bg: rgba(31, 32, 37, 0.98);
      --clr-chatbot-border: rgba(255, 255, 255, 0.1);
      --clr-chatbot-bot-bg: rgba(24, 24, 27, 0.95);
      --clr-chatbot-user-bg: rgba(37, 99, 168, 0.28);
      --clr-chatbot-input-bg: rgba(5, 5, 8, 0.85);
      --clr-chatbot-accent: var(--clr-accent-primary);
      --chatbot-width: 520px;
      --chatbot-height: 480px;
      --font-hd: 'Orbitron', sans-serif;
      --font-mono: 'Share Tech Mono', monospace;
      --font-body: 'Inter', sans-serif;
      --spacing-xs: 4px;
      --spacing-sm: 8px;
      --spacing-md: 16px;
      --spacing-lg: 24px;
      --spacing-xl: 32px;
      --spacing-2xl: 48px;
      --spacing-3xl: 64px;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-body);
      background: var(--clr-bg);
      color: var(--clr-white);
      overflow-x: hidden;
      min-height: 100vh;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    ::-webkit-scrollbar {
      width: 4px;
    }

    ::-webkit-scrollbar-track {
      background: var(--clr-bg);
    }

    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, var(--clr-accent-primary), var(--clr-secondary-light));
      border-radius: 2px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, var(--clr-accent-light), var(--clr-secondary-light));
    }

    /* ─── BACKGROUND ANIMATED LAYERS ──────────────────── */
    /* ─── BACKGROUND LAYERS ────────────────────────────────── */
    .bg-fixed-grid {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(59, 125, 216, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59, 125, 216, 0.04) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    .bg-fixed-radial {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(26, 58, 110, 0.18) 0%, transparent 70%);
    }

    .bg-scanlines {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: 0.25;
      background: linear-gradient(to bottom,
          rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 50%,
          rgba(0, 0, 0, 0.15) 50%, rgba(0, 0, 0, 0.15) 100%);
      background-size: 100% 4px;
    }

    .bg-vertical-streaks {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image: linear-gradient(90deg, transparent 99%, rgba(59, 125, 216, 0.05) 100%);
      background-size: 8vw 100%;
    }

    /* Animated floating orbs */
    .orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
      z-index: 0;
      opacity: 0.12;
      animation: orb-drift 18s ease-in-out infinite alternate;
    }

    .orb-1 {
      width: 600px;
      height: 600px;
      background: var(--clr-accent);
      top: -200px;
      left: -200px;
      animation-duration: 20s;
    }

    .orb-2 {
      width: 400px;
      height: 400px;
      background: var(--clr-accent2);
      bottom: -100px;
      right: -100px;
      animation-duration: 15s;
      animation-delay: -7s;
    }

    .orb-3 {
      width: 300px;
      height: 300px;
      background: var(--clr-gold);
      top: 40%;
      left: 60%;
      animation-duration: 25s;
      animation-delay: -3s;
      opacity: 0.06;
    }

    @keyframes orb-drift {
      from {
        transform: translate(0, 0) scale(1);
      }

      to {
        transform: translate(60px, 40px) scale(1.1);
      }
    }


    .bg-fixed-radial {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(201, 168, 76, 0.12) 0%, transparent 70%);
    }

    .bg-scanlines {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: 0.15;
      background: linear-gradient(to bottom,
          rgba(255, 87, 87, 0) 0%,
          rgba(255, 161, 54, 0) 50%,
          rgba(0, 0, 0, 0.15) 50%,
          rgba(0, 0, 0, 0.15) 100%);
      background-size: 100% 4px;
      animation: scanline-move 8s linear infinite;
    }

    .bg-vertical-streaks {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image: linear-gradient(90deg, transparent 99%, rgba(201, 168, 76, 0.04) 100%);
      background-size: 8vw 100%;
    }

    .orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
      z-index: 0;
      opacity: 0.08;
      animation: orb-drift 18s ease-in-out infinite alternate;
    }

    .orb-1 {
      width: 600px;
      height: 600px;
      background: var(--clr-accent-primary);
      top: -200px;
      left: -200px;
      animation-duration: 20s;
    }

    .orb-2 {
      width: 400px;
      height: 400px;
      background: var(--clr-secondary);
      bottom: -100px;
      right: -100px;
      animation-duration: 15s;
      animation-delay: -7s;
    }

    .orb-3 {
      width: 300px;
      height: 300px;
      background: var(--clr-accent-light);
      top: 40%;
      left: 60%;
      animation-duration: 25s;
      animation-delay: -3s;
      opacity: 0.04;
    }

    @keyframes orb-drift {
      from {
        transform: translate(0, 0) scale(1);
      }

      to {
        transform: translate(60px, 40px) scale(1.1);
      }
    }

    @keyframes scanline-move {
      0% {
        transform: translateY(-100%);
      }

      100% {
        transform: translateY(100%);
      }
    }



    .lead-form {
      width: 100%;
      max-width: 1000px;
      margin: 0 auto;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .form-group label {
      margin-bottom: 14px;
      color: var(--clr-text-secondary);
      font-size: 1rem;
    }

    .form-group select {
      background: rgba(15, 23, 42, 0.95);
      color: #a9a7a7;
      border: 1px solid rgba(0, 255, 255, 0.20);
      border-radius: 12px;
      padding: 14px 16px;
      font-size: 1rem;
      backdrop-filter: blur(10px);
      transition: all .3s ease;
    }

    .form-group select:hover {
      border-color: rgba(255, 133, 11, 0.45);
    }

    .form-group select:focus {
      outline: none;
      border-color: #00FFFF;
      box-shadow: 0 0 20px rgba(0, 255, 255, 0.20);
    }

    .form-group select option {
      background: #0F172A;
      color: #ababab;
    }


    @media(max-width:768px) {

      .form-grid {
        grid-template-columns: 1fr;
      }

    }

    /* ─── SCROLL PROGRESS ─────────────────────────────── */
    #scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 2px;
      width: 100%;
      z-index: 200;
      background: linear-gradient(90deg, var(--clr-accent-primary), var(--clr-secondary-light), var(--clr-accent-light));
      transform-origin: left center;
      transform: scaleX(0);
      transition: transform 80ms linear;
    }

    /* ─── NAVIGATION ──────────────────────────────────── */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: rgba(5, 5, 8, 0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--clr-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 var(--spacing-2xl);
      height: 64px;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
      font-family: var(--font-hd);
      font-size: 11px;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--clr-white);
      text-decoration: none;
      transition: all 0.3s ease;
      flex-shrink: 0;
    }

    .nav-brand:hover {
      opacity: 0.9;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border-radius: 0;
      box-shadow: none;
      width: auto;
      height: auto;
    }

    .nav-logo img {
      display: block;
      height: 44px;
      width: auto;
      max-width: 160px;
      object-fit: contain;
    }

    .nav-pulse {
      width: 8px;
      height: 8px;
      background: var(--clr-secondary-light);
      border-radius: 50%;
      animation: pulse-glow 2s ease-in-out infinite;
      box-shadow: 0 0 8px var(--clr-secondary-light);
    }

    @keyframes pulse-glow {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.3;
      }
    }

    .nav-links {
      display: flex;
      gap: var(--spacing-2xl);
      align-items: center;
    }

    .nav-link {
      font-family: var(--font-body);
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--clr-muted);
      text-decoration: none;
      transition: all 0.3s ease;
      position: relative;
    }

    .nav-link::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 1px;
      background: var(--clr-accent-primary);
      transition: width 0.3s ease;
    }

    .nav-link:hover {
      color: var(--clr-white);
    }

    .nav-link:hover::after {
      width: 100%;
    }

    .nav-status {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--clr-muted);
      letter-spacing: 0.15em;
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }

    .status-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--clr-success);
      box-shadow: 0 0 8px var(--clr-success);
      animation: pulse-glow 2s ease-in-out infinite;
    }

    /* ─── MAIN CONTENT ────────────────────────────────── */
    main {
      position: relative;
      z-index: 10;
    }

    .slide {
      min-height: 100vh;
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 80px 40px 40px;
      border-bottom: 1px solid var(--clr-border);
      position: relative;
      overflow: hidden;
      scroll-margin-top: 64px;
    }

    .slide-container {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      position: relative;
      z-index: 10;
    }

    .slide-center {
      align-items: center;
      text-align: center;
      justify-content: center;
    }

    @media (max-width: 768px) {
      .slide {
        padding: 80px 24px 40px;
      }

      nav {
        padding: 0 var(--spacing-md);
      }

      .nav-links {
        display: none;
      }
    }

    /* ─── GLASS CARDS ─────────────────────────────────── */
    .glass {
      background: rgba(10, 12, 20, 0.65);
      backdrop-filter: blur(16px);
      border: 1px solid var(--clr-border);
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    .glass:hover {
      border-color: rgba(201, 168, 76, 0.3);
      background: rgba(10, 12, 20, 0.8);
      box-shadow: 0 8px 32px rgba(201, 168, 76, 0.1);
    }

    .glass-accent {
      background: rgba(201, 168, 76, 0.08);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(201, 168, 76, 0.2);
      border-radius: 2px;
    }

    /* ─── ANIMATIONS ──────────────────────────────────── */
    @keyframes float-up {
      0% {
        opacity: 0;
        transform: translateY(30px);
      }

      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes shimmer-text {
      0% {
        background-position: -200% center;
      }

      100% {
        background-position: 200% center;
      }
    }

    @keyframes glow-pulse {

      0%,
      100% {
        box-shadow: 0 0 20px rgba(201, 168, 76, 0.5), inset 0 0 20px rgba(201, 168, 76, 0.1);
      }

      50% {
        box-shadow: 0 0 40px rgba(201, 168, 76, 0.8), inset 0 0 30px rgba(201, 168, 76, 0.2);
      }
    }

    @keyframes scan-line {
      0% {
        transform: translateX(-100%);
      }

      100% {
        transform: translateX(350%);
      }
    }

    .reveal {
      opacity: 0;
      transform: translate3d(0, 28px, 0);
      animation: float-up 0.8s ease 0.3s forwards;
    }

    .reveal.delay-1 {
      animation-delay: 0.4s;
    }

    .reveal.delay-2 {
      animation-delay: 0.5s;
    }

    .reveal.delay-3 {
      animation-delay: 0.6s;
    }

    .reveal.delay-4 {
      animation-delay: 0.7s;
    }

    .reveal.delay-5 {
      animation-delay: 0.8s;
    }

    /* ─── TYPOGRAPHY ──────────────────────────────────── */
    h1 {
      font-family: var(--font-hd);
      font-size: clamp(2.8rem, 6vw, 5.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin-bottom: var(--spacing-lg);
    }

    h2 {
      font-family: var(--font-hd);
      font-size: clamp(1.8rem, 4vw, 3.2rem);
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.1;
      margin-bottom: var(--spacing-lg);
    }

    h3 {
      font-family: var(--font-hd);
      font-size: clamp(1rem, 2vw, 1.4rem);
      font-weight: 500;
      letter-spacing: 0.05em;
      line-height: 1.2;
      margin-bottom: var(--spacing-md);
    }

    h4 {
      font-family: var(--font-hd);
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: var(--spacing-md);
    }

    p {
      margin-bottom: var(--spacing-md);
    }

    .body-text {
      font-size: clamp(0.875rem, 1.5vw, 1rem);
      line-height: 1.75;
      color: var(--clr-muted);
      max-width: 680px;
    }

    .body-sm {
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--clr-dim);
    }

    .label {
      font-family: var(--font-hd);
      font-size: 8px;
      letter-spacing: 0.5em;
      text-transform: uppercase;
      color: var(--clr-accent-primary);
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-lg);
    }

    .label::before {
      content: '';
      display: block;
      width: 32px;
      height: 1px;
      background: var(--clr-accent-primary);
    }

    .label-num {
      color: var(--clr-muted);
    }

    .caption {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--clr-dim);
    }

    .gradient-text {
      background: linear-gradient(135deg, var(--clr-accent-primary) 0%, var(--clr-accent-light) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: shimmer-text 3s ease-in-out infinite;
      background-size: 200% auto;
    }

    .glow-text {
      color: var(--clr-accent-primary);
      text-shadow: 0 0 20px rgba(201, 168, 76, 0.5);
    }

    .mono {
      font-family: var(--font-mono);
    }

    .divider {
      height: 1px;
      background: linear-gradient(90deg, var(--clr-accent-primary), transparent);
      margin: var(--spacing-2xl) 0;
      width: 200px;
    }

    /* ─── BUTTONS ─────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--spacing-sm);
      font-family: var(--font-hd);
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      padding: 16px 40px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      border-radius: 2px;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--clr-accent-primary), var(--clr-accent-light));
      color: var(--clr-bg);
      border: 1px solid transparent;
      font-weight: 700;
    }

    .btn-primary:hover {
      box-shadow: 0 0 30px rgba(201, 168, 76, 0.6);
      transform: translateY(-2px);
    }

    .btn-secondary {
      background: transparent;
      color: var(--clr-white);
      border: 1px solid var(--clr-accent-primary);
    }

    .btn-secondary:hover {
      background: rgba(201, 168, 76, 0.1);
      border-color: var(--clr-accent-light);
      box-shadow: inset 0 0 20px rgba(201, 168, 76, 0.2);
    }

    /* ─── CARDS & METRICS ─────────────────────────────── */
    .card {
      padding: var(--spacing-lg);
      background: var(--clr-surface-light);
      border: 1px solid var(--clr-border);
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    .card:hover {
      border-color: rgba(201, 168, 76, 0.3);
      box-shadow: 0 8px 32px rgba(201, 168, 76, 0.1);
      transform: translateY(-4px);
    }

    .card-title {
      font-family: var(--font-hd);
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: var(--spacing-md);
      color: var(--clr-white);
    }

    .card-content {
      color: var(--clr-muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* ─── BADGES ──────────────────────────────────────── */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-xs);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 6px 14px;
      background: rgba(201, 168, 76, 0.08);
      border: 1px solid rgba(201, 168, 76, 0.3);
      color: var(--clr-accent-primary);
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    .badge:hover {
      background: rgba(201, 168, 76, 0.15);
      border-color: var(--clr-accent-primary);
    }

    .hero-badges .badge {
      color: var(--clr-hero-badge);
      background: var(--clr-hero-badge-bg);
      border-color: var(--clr-hero-badge-border);
    }

    .hero-badges .badge:hover {
      background: var(--clr-hero-badge-bg-hover);
      border-color: var(--clr-hero-badge);
    }

    /* ─── SECTION DECORATIONS ────────────────────────── */
    .scan-bar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      overflow: hidden;
    }

    .scan-bar::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 40%;
      height: 100%;
      background: linear-gradient(90deg, transparent, var(--clr-accent-primary), transparent);
      animation: scan-line 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    .slide-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border-color: rgba(201, 168, 76, 0.3);
      border-style: solid;
    }

    .slide-corner.tl {
      top: 80px;
      left: 40px;
      border-width: 1px 0 0 1px;
    }

    .slide-corner.br {
      bottom: 40px;
      right: 40px;
      border-width: 0 1px 1px 0;
    }

    .slide-num {
      position: absolute;
      bottom: 48px;
      left: 80px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.2em;
      color: var(--clr-dim);
    }

    /* ─── PROFILE SECTION ─────────────────────────────── */
    .profile-card {
      display: flex;
      gap: var(--spacing-2xl);
      align-items: flex-start;
      max-width: 1100px;
      margin: var(--spacing-2xl) 0;
      margin-right: auto;
    }

    .profile-card--idealizador {
      width: 100%;
      align-items: flex-start;
    }

    .profile-card--idealizador .profile-image {
      width: min(300px, 38%);
      max-width: 300px;
      height: 400px;
      min-width: 0;
      flex-shrink: 0;
    }

    .profile-card--idealizador .profile-content {
      flex: 1;
      min-width: 0;
    }

    .profile-image {
      flex-shrink: 0;
      border-radius: 2px;
      overflow: hidden;
      border: 1px solid var(--clr-border);
      box-shadow: 0 12px 40px rgba(201, 168, 76, 0.15);
      animation: float-up 0.8s ease 0.2s forwards;
    }

    .profile-image img {
      width: 240px;
      height: 280px;
      object-fit: cover;
      display: block;
    }

    .profile-content {
      flex: 1;
    }

    .profile-name {
      font-family: var(--font-hd);
      font-size: 2.5rem;
      font-weight: 900;
      letter-spacing: -0.01em;
      margin-bottom: var(--spacing-sm);
      background: linear-gradient(135deg, var(--clr-accent-primary), var(--clr-accent-light));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .profile-role {
      font-family: var(--font-hd);
      font-size: 1.2rem;
      color: var(--clr-secondary-light);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: var(--spacing-lg);
    }

    .profile-bio {
      margin-bottom: var(--spacing-lg);
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      font-size: 0.95rem;
      margin-bottom: var(--spacing-lg);
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      color: var(--clr-muted);
    }

    .contact-item strong {
      color: var(--clr-accent-primary);
      font-family: var(--font-mono);
      min-width: 90px;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: var(--spacing-md);
      margin: var(--spacing-lg) 0;
    }

    .skill-tag {
      padding: 8px 12px;
      background: rgba(201, 168, 76, 0.08);
      border: 1px solid rgba(201, 168, 76, 0.3);
      border-radius: 2px;
      font-size: 0.85rem;
      color: var(--clr-accent-primary);
      text-align: center;
      transition: all 0.3s ease;
    }

    .skill-tag:hover {
      background: rgba(201, 168, 76, 0.15);
      border-color: var(--clr-accent-primary);
    }

    #idealizador .skill-tag {
      color: var(--clr-hero-badge);
      background: var(--clr-hero-badge-bg);
      border-color: var(--clr-hero-badge-border);
    }

    #idealizador .skill-tag:hover {
      background: var(--clr-hero-badge-bg-hover);
      border-color: var(--clr-hero-badge);
    }

    /* ─── GRID LAYOUTS ────────────────────────────────── */
    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-2xl);
    }

    .three-col {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-lg);
    }

    .metric-grid {
      display: grid;
      gap: var(--spacing-lg);
    }

    .metric-grid-2 {
      grid-template-columns: repeat(2, 1fr);
    }

    .metric-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .metric-grid-4 {
      grid-template-columns: repeat(4, 1fr);
    }

    .metric-value {
      font-family: var(--font-hd);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      line-height: 1;
      margin-bottom: var(--spacing-sm);
      background: linear-gradient(135deg, var(--clr-accent-primary), var(--clr-accent-light));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .metric-label {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--clr-muted);
      margin-bottom: var(--spacing-sm);
    }

    .metric-desc {
      font-size: 0.8rem;
      color: var(--clr-dim);
      line-height: 1.5;
    }

    .step-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .step-item {
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: var(--spacing-lg);
      padding: var(--spacing-lg) 0;
      border-bottom: 1px solid var(--clr-border);
      transition: background 0.3s ease;
    }

    .step-item:last-child {
      border-bottom: none;
    }

    .step-item:hover {
      background: rgba(201, 168, 76, 0.05);
    }

    .step-num {
      font-family: var(--font-hd);
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      color: var(--clr-accent-primary);
      padding-top: 4px;
      white-space: nowrap;
      text-shadow: 0 0 12px rgba(201, 168, 76, 0.3);
    }

    .step-title {
      font-family: var(--font-hd);
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      margin-bottom: var(--spacing-sm);
      color: var(--clr-white);
    }

    .step-body {
      font-size: 0.85rem;
      color: var(--clr-muted);
      line-height: 1.7;
    }

    .big-quote {
      border-left: 3px solid var(--clr-accent-primary);
      padding: var(--spacing-lg) var(--spacing-2xl);
      margin: var(--spacing-2xl) 0;
      background: rgba(201, 168, 76, 0.06);
      border-radius: 2px;
    }

    .big-quote p {
      font-family: var(--font-hd);
      font-size: clamp(1rem, 2.5vw, 1.5rem);
      font-weight: 500;
      line-height: 1.5;
      letter-spacing: 0.03em;
      color: var(--clr-white);
    }

    .big-quote span {
      color: var(--clr-accent-primary);
    }

    /* ─── RESPONSIVE ──────────────────────────────────── */
    @media (max-width: 900px) {
      .two-col {
        grid-template-columns: 1fr;
      }

      .three-col {
        grid-template-columns: repeat(2, 1fr);
      }

      .metric-grid-3,
      .metric-grid-4 {
        grid-template-columns: repeat(2, 1fr);
      }

      .profile-card {
        flex-direction: column;
        text-align: center;
      }

      .profile-card--idealizador {
        align-items: center;
      }

      .profile-card--idealizador .profile-image {
        width: min(280px, 90vw);
        max-width: none;
        height: min(360px, 75vw);
      }

      .profile-card--idealizador .profile-content {
        width: 100%;
        max-width: 560px;
        text-align: left;
      }

      .profile-image img {
        width: 200px;
        height: 240px;
      }

      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .three-col {
        grid-template-columns: 1fr;
      }

      .metric-grid-2,
      .metric-grid-3,
      .metric-grid-4 {
        grid-template-columns: 1fr;
      }

      .profile-image img {
        width: 160px;
        height: 200px;
      }

      .profile-name {
        font-size: 1.8rem;
      }

      .profile-role {
        font-size: 1rem;
      }

      .skills-grid {
        grid-template-columns: 1fr;
      }
    }

    .hidden {
      display: none;
    }

    /* ═══ BACKGROUND AXIOM 4 (Unicorn + grid + efeitos) ═══ */
    .bg-grid {
      background-size: 40px 40px;
      background-image:
        linear-gradient(to right, rgba(39, 39, 42, 0.8) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(39, 39, 42, 0.8) 1px, transparent 1px);
    }

    .axiom-bg-layer {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .axiom-bg-layer .aura-background-component,
    .axiom-bg-layer [data-us-project] {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .axiom-bg-grid-overlay {
      position: absolute;
      inset: 0;
      opacity: 0.04;
      background-size: 40px 40px;
      background-image:
        linear-gradient(to right, #27272a 1px, transparent 1px),
        linear-gradient(to bottom, #27272a 1px, transparent 1px);
    }

    .axiom-bg-radial {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 40%, rgba(234, 88, 12, 0.12) 0%, transparent 55%);
      mix-blend-mode: screen;
    }

    .axiom-bg-scanlines {
      position: absolute;
      inset: 0;
      opacity: 0.2;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
      background-size: 100% 2px;
    }

    .axiom-bg-crt {
      position: absolute;
      inset: 0;
      opacity: 0.15;
      background: linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
      background-size: 3px 100%;
    }

    nav,
    main,
    #scroll-progress {
      position: relative;
      z-index: 2;
    }

    body>.bg-fixed-grid,
    body>.bg-fixed-radial,
    body>.bg-scanlines,
    body>.bg-vertical-streaks,
    body>.orb {
      display: none !important;
    }

    .slide {
      background: linear-gradient(180deg, rgba(5, 5, 8, 0.45) 0%, rgba(5, 5, 8, 0.72) 100%);
    }

    #hero.slide {
      background: linear-gradient(180deg, rgba(5, 5, 8, 0.25) 0%, rgba(5, 5, 8, 0.55) 100%);
      justify-content: center;
      text-align: left;
    }

    #empresa.slide {
      background: var(--clr-chumbo);
    }

    #diagnostico.slide {
      background: var(--clr-chumbo);
    }

    @keyframes spinSlow {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    .animate-spin-slow {
      animation: spinSlow 6s linear infinite;
    }

    @keyframes sys-flicker {
      0% {
        opacity: 0.08;
      }

      6% {
        opacity: 1;
      }

      12% {
        opacity: 0.08;
      }

      18% {
        opacity: 1;
      }

      100% {
        opacity: 1;
      }
    }

    .sys-flicker-anim,
    .hero-cam-badge {
      animation: sys-flicker 2.4s linear forwards;
      opacity: 0;
    }

    .hero-axiom-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      align-items: center;
    }

    @media (min-width: 900px) {
      .hero-axiom-grid {
        grid-template-columns: minmax(0, 1fr) 520px;
        gap: 48px;
      }
    }

    #hero .hero-head-content {
      text-align: left;
    }

    #hero .hero-badges,
    #hero .hero-cta-group {
      justify-content: flex-start !important;
    }

    #hero .body-text {
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .hero-visual-module {
      position: relative;
      min-height: 380px;
      width: 100%;
      background: #18181b;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      overflow: hidden;
    }

    .hero-visual-module .hero-bg-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: contrast(1) brightness(0.5);
      transform: scaleX(-1);
      transition: filter 1s ease, transform 1s ease;
      mask-image: linear-gradient(0deg, transparent, black 5%, black 95%, transparent);
      -webkit-mask-image: linear-gradient(0deg, transparent, black 5%, black 95%, transparent);
    }

    .hero-visual-module:hover .hero-bg-image {
      filter: brightness(0.85);
      transform: scaleX(-1.03) scaleY(1.03);
    }

    .hero-visual-scanline {
      position: absolute;
      inset: 0;
      z-index: 10;
      pointer-events: none;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
      background-size: 100% 2px;
    }

    .hero-tech-overlay {
      position: absolute;
      inset: 0;
      z-index: 20;
      pointer-events: none;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .hero-cam-badge {
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(6px);
      border: 1px solid #3f3f46;
      padding: 6px 10px;
      font-family: var(--font-mono);
      font-size: 10px;
      color: #fff;
      letter-spacing: 0.1em;
      width: fit-content;
    }

    .hero-data-panel {
      align-self: flex-end;
      background: rgba(5, 5, 5, 0.9);
      border: 1px solid #3f3f46;
      padding: 14px;
      width: 220px;
    }

    .hero-data-panel h4 {
      font-family: var(--font-mono);
      font-size: 10px;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      border-bottom: 1px solid #27272a;
      padding-bottom: 8px;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .hero-data-panel .pulse-dot {
      width: 6px;
      height: 6px;
      background: #22c55e;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.4;
      }
    }

    .hero-bar-row {
      display: flex;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 10px;
      color: #71717a;
      margin-bottom: 6px;
    }

    .hero-bar-row span:last-child {
      color: #fff;
    }

    .hero-bar-track {
      width: 100%;
      height: 2px;
      background: #27272a;
      margin-bottom: 10px;
    }

    .hero-bar-fill {
      height: 100%;
      background: var(--clr-accent-primary);
      width: 0;
      transition: width 2s ease;
    }

    .profile-image .hero-visual-module {
      min-height: 0;
      height: 100%;
      width: 100%;
    }

    .profile-image .hero-bg-image {
      transform: none;
    }

    .profile-image .hero-visual-module:hover .hero-bg-image {
      filter: brightness(0.85);
      transform: scale(1.03);
    }

    .profile-image .hero-data-panel {
      width: min(220px, 90%);
      padding: 10px;
    }

    .profile-image .hero-cam-badge {
      font-size: 9px;
      padding: 5px 8px;
    }

    .performance-index {
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(9, 9, 11, 0.85);
      backdrop-filter: blur(8px);
      border-radius: 4px;
      overflow: hidden;
      margin-top: 24px;
      max-width: 1100px;
      margin-left: auto;
      margin-right: auto;
    }

    .performance-index-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 14px 16px;
      border-bottom: 1px solid #27272a;
    }

    .performance-index-header .label {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--clr-accent-primary);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .performance-index-header .sub {
      font-family: var(--font-mono);
      font-size: 8px;
      color: #52525b;
      text-transform: uppercase;
      margin-top: 4px;
    }

    .performance-index-header .value {
      font-family: var(--font-mono);
      font-size: 10px;
      color: #fff;
    }

    .performance-index-chart {
      padding: 16px;
      min-height: 140px;
    }

    .perf-grid-dots {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 4px;
      height: 60px;
      margin-bottom: 12px;
    }

    .perf-grid-dots div {
      background: #27272a;
    }

    .perf-grid-dots div.accent {
      background: var(--clr-accent-primary);
      opacity: 0.8;
    }

    .perf-bars {
      display: flex;
      align-items: flex-end;
      gap: 6px;
      height: 80px;
    }

    .perf-bars .bar {
      flex: 1;
      background: #27272a;
      transition: background 0.3s;
    }

    .perf-bars .bar:hover {
      background: var(--clr-accent-primary);
    }

    .perf-bars .bar.peak {
      background: #fff;
    }

    .feature-image-card {
      position: relative;
      height: 200px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      margin-top: 16px;
      max-width: 1100px;
      margin-left: auto;
      margin-right: auto;
    }

    .feature-image-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.5) contrast(1);
      transition: filter 0.5s;
    }

    .feature-image-card:hover img {
      filter: brightness(0.9);
    }

    .feature-image-card .badge {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 2;
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      color: #fff;
      background: #000;
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 4px 8px;
    }

    /* ─── CONTATO — UnicornStudio local (index.html) ─── */
    #contato.slide {
      overflow: hidden;
      background: var(--clr-surface);
    }

    #contato .contato-bg-layer {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
    }

    #contato .contato-bg-layer .aura-background-component,
    #contato .contato-bg-layer [data-us-project] {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    #contato .contato-bg-grid {
      position: absolute;
      inset: 0;
      opacity: 0.2;
      background-size: 60px 60px;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    }

    #contato .contato-bg-radial {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(234, 88, 12, 0.15) 0%, transparent 50%);
      mix-blend-mode: screen;
    }

    #contato .contato-bg-scanlines {
      position: absolute;
      inset: 0;
      z-index: 1;
      opacity: 0.2;
      background:
        linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%),
        linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
      background-size: 100% 2px, 3px 100%;
    }

    #contato .contato-content {
      position: relative;
      z-index: 20;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      width: 100%;
      max-width: 960px;
      padding: 0 24px;
    }

    #contato .contato-status {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 48px;
    }

    #contato .contato-status-line {
      width: 48px;
      height: 1px;
      background: #27272a;
    }

    #contato .contato-status-badge {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 4px 12px;
      background: rgba(24, 24, 27, 0.5);
      border: 1px solid #27272a;
      font-family: var(--font-mono);
      font-size: 10px;
      color: #a1a1aa;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      backdrop-filter: blur(8px);
    }

    #contato .contato-status-dot {
      position: relative;
      display: flex;
      width: 8px;
      height: 8px;
    }

    #contato .contato-status-dot-ping {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: #22c55e;
      opacity: 0.75;
      animation: contato-ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    #contato .contato-status-dot-core {
      position: relative;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #22c55e;
    }

    @keyframes contato-ping {

      75%,
      100% {
        transform: scale(2);
        opacity: 0;
      }
    }

    #contato .scan-bar,
    #contato .slide-num {
      position: relative;
      z-index: 20;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ─── CHATBOT COMERCIAL — 5ª dobra ───────────────── */
    .chatbot {
      width: 100%;
      max-width: var(--chatbot-width);
      height: var(--chatbot-height);
      margin-top: 32px;
      display: flex;
      flex-direction: column;
      background: var(--clr-chatbot-bg);
      border: 1px solid var(--clr-chatbot-border);
      border-radius: 4px;
      overflow: hidden;
      backdrop-filter: blur(12px);
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
      text-align: left;
    }

    .chatbot-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 16px 20px;
      background: var(--clr-chatbot-header-bg);
      border-bottom: 1px solid var(--clr-chatbot-border);
    }

    .chatbot-header-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .chatbot-avatar {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 4px;
      background: rgba(251, 117, 7, 0.12);
      border: 1px solid rgba(251, 117, 7, 0.35);
      color: var(--clr-chatbot-accent);
      font-size: 18px;
    }

    .chatbot-title {
      font-family: var(--font-hd);
      font-size: 13px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin: 0;
      color: var(--clr-white);
    }

    .chatbot-status {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #22c55e;
    }

    .chatbot-messages {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .chatbot-message {
      max-width: 85%;
      padding: 12px 14px;
      border-radius: 4px;
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .chatbot-message p {
      margin: 0;
    }

    .chatbot-message time {
      display: block;
      margin-top: 6px;
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.55;
    }

    .chatbot-message--bot {
      align-self: flex-start;
      background: var(--clr-chatbot-bot-bg);
      border: 1px solid var(--clr-chatbot-border);
      color: var(--clr-white);
    }

    .chatbot-message--user {
      align-self: flex-end;
      background: var(--clr-chatbot-user-bg);
      border: 1px solid rgba(59, 125, 216, 0.35);
      color: var(--clr-white);
    }

    .chatbot-message--typing {
      align-self: flex-start;
      background: var(--clr-chatbot-bot-bg);
      border: 1px solid var(--clr-chatbot-border);
      color: var(--clr-muted);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
    }

    .chatbot-suggestions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 0 20px 12px;
    }

    .chatbot-suggestion {
      padding: 6px 12px;
      background: transparent;
      border: 1px solid rgba(251, 117, 7, 0.35);
      border-radius: 2px;
      color: var(--clr-chatbot-accent);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .chatbot-suggestion:hover {
      background: rgba(251, 117, 7, 0.12);
      border-color: var(--clr-chatbot-accent);
    }

    .chatbot-form {
      display: flex;
      gap: 10px;
      padding: 16px 20px;
      border-top: 1px solid var(--clr-chatbot-border);
      background: rgba(5, 5, 8, 0.6);
    }

    .chatbot-input {
      flex: 1;
      padding: 12px 14px;
      background: var(--clr-chatbot-input-bg);
      border: 1px solid var(--clr-chatbot-border);
      border-radius: 2px;
      color: var(--clr-white);
      font-family: var(--font-body);
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.25s ease;
    }

    .chatbot-input:focus {
      border-color: var(--clr-chatbot-accent);
    }

    .chatbot-input::placeholder {
      color: var(--clr-dim);
    }

    .chatbot-send {
      padding: 12px 20px;
      font-size: 10px;
      letter-spacing: 0.15em;
      white-space: nowrap;
    }

    .chatbot-footer {
      padding: 10px 20px 14px;
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--clr-dim);
      text-align: center;
      border-top: 1px solid rgba(255, 255, 255, 0.04);
    }

    @media (max-width: 768px) {
      .chatbot {
        --chatbot-height: 420px;
      }

      .chatbot-form {
        flex-direction: column;
      }

      .chatbot-send {
        width: 100%;
      }
    }
  </style>
  <script src="assets/iconify-icon_e19829e7f0e8.js"></script>
</head>

