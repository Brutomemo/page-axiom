{
  "projectSettings": {
    "framework": "static"
  },
  "buildCommand": "",
  "outputDirectory": ".",
  
  "functions": {
    "api/**/*.js": {
      "memory": 512,
      "maxDuration": 30,
      "runtime": "nodejs20.x"
    }
  },

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],

  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}